# ============================================================================
# Copiar este archivo a `.env` y completar. `.env` NUNCA se sube al repo.
# Ningún valor de acá llega al navegador: todo se usa solo del lado del servidor.
# ============================================================================

# --- Base de datos (obligatorio) -------------------------------------------
# Neon: panel del proyecto -> Connection string -> "Pooled connection".
# Ejemplo: postgresql://usuario:clave@ep-algo-123.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# URL pública final del sistema. Se usa para armar el link de gestión que va
# en el mail. En Render no hace falta: si queda vacía se usa la que Render
# define sola (RENDER_EXTERNAL_URL), y en local se deduce del pedido.
URL_PUBLICA=

# Demo de portfolio: 1 = muestra en las páginas públicas el aviso de
# "negocio ficticio". Con un cliente real, dejarlo vacío.
MODO_DEMO=

# --- Panel del dueño --------------------------------------------------------
# Se usan UNA vez, al correr `npm run sembrar`. Después la contraseña queda
# hasheada en la base y conviene borrar PANEL_PASSWORD de este archivo.
PANEL_USUARIO=hugo
PANEL_PASSWORD=
HORAS_SESION=8

# --- Mails (opcional) -------------------------------------------------------
# Si estas variables quedan vacías, el sistema funciona igual y escribe los
# mails en la consola. Sirve para desarrollar sin conectar una casilla real.
#
# Para Gmail: NO es la contraseña de la cuenta, es una "contraseña de
# aplicación" que se genera con verificación en dos pasos activada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Barbería Ramírez <turnos@ejemplo.com>"

# Casilla donde el dueño quiere recibir el aviso de cada turno nuevo.
EMAIL_DUENO=
